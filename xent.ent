<!-- This may look awkward, but DocBook ENTITIES are defined once and cannot be
     redefined from the looks of it, so the one version you want for it to
     appear must be the one defined first. So this ends up looking like an
     if-else statement without the else. -->

<!ENTITY source-profile
  "<para>Now source the main profile:</para>
   <screen><userinput>source /etc/profile</userinput></screen>">

<!ENTITY abi-break
  "<important><para>Updating this package is known
  to break ABI.</para></important>">

<!ENTITY meson-cross
  "<important><para>For the lib32 installation instructions, they require new
  Meson cross files from <ulink
  url='&mlfs-root;/chapter08/meson.html'>MLFS</ulink>, as
  <parameter>--libdir=/usr/lib32</parameter> has been moved to the cross files
  and no longer appear in the instructions. Install the new cross files so that
  32-bit libraries don't get installed in <filename
  class='directory'>/usr/lib</filename>.</para></important>">

<!ENTITY parallel_issues
  "<note><para>This package may occasionally fail when
  building with multiple processors.  See <xref
  linkend='parallel-builds'/> for more information.</para></note>">

<!ENTITY shell-env
  "<note><para>If installing in the chroot environment, be
  sure to export the <envar>SHELL</envar> environment
  variable or configuration of the package will
  fail.</para></note>">

<!ENTITY gi-doc-disable
  "Allow building this package without <xref linkend='gi-docgen'/>
  installed.  If you have <xref linkend='gi-docgen'/> installed and
  you wish to rebuild and install the API documentation, a
